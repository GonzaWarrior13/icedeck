{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "file_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "local",
        "itunes",
        "youtube",
        "spotify"
      ],
      "default": "local"
    },
    "preview_url": {
      "type": "string"
    },
    "spotify_id": {
      "type": "string"
    },
    "spotify_uri": {
      "type": "string"
    },
    "start_point": {
      "type": "number",
      "default": 0
    },
    "end_point": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "energy_level": {
      "type": "number"
    },
    "bpm": {
      "type": "number"
    },
    "volume": {
      "type": "number",
      "default": 100
    },
    "loudness_db": {
      "type": "number"
    },
    "play_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}